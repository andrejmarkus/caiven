# Copy to .env in the repo root and fill in what you need.
# caiven-port loads this file automatically on startup (via dotenvy).
# Anything left unset degrades gracefully (feature hidden/disabled), never crashes.

# Postgres/SQLite connection string. Omit to use the default SQLite file under --data-dir.
# DATABASE_URL=postgres://user:pass@localhost/caiven_port

# Public base URL of this server. Required for OAuth redirect URIs and WebAuthn/passkeys.
CAIVEN_BASE_URL=http://localhost:8080

# Set to true when serving over HTTPS so auth cookies get the Secure flag.
CAIVEN_SECURE_COOKIES=false

# SMTP (email verification, password reset, security alerts). Falls back to logging to stdout if unset.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Caiven <noreply@example.com>

# Cloudflare Turnstile (antibot on register/login). Hidden on the frontend if unset.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# OAuth providers. Each pair (id+secret) enables that provider; a partial pair is ignored.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
