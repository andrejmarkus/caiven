{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caiven Studio",
  "version": "0.3.0",
  "identifier": "dev.caiven.studio",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../caiven-studio-ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../caiven-studio-ui"
    },
    "frontendDist": "../caiven-studio-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Caiven Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
