{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:ui": "node ../../caiven-ui/scripts/check-boundaries.mjs",
    "test:e2e": "npm run test:e2e:mock && npm run test:e2e:live",
    "test:e2e:mock": "playwright test --config playwright.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:stress": "playwright test --config playwright.config.ts --repeat-each=3",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui"
  },
  "devDependencies": {
    "@lucide/svelte": "1.26.0",
    "@playwright/test": "1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "svelte": "^5.56.4",
    "shadcn-svelte": "1.5.0",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@caiven/ui": "file:../../caiven-ui",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@internationalized/date": "3.12.2",
    "@tailwindcss/forms": "0.5.11",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "mode-watcher": "1.1.0",
    "svelte-sonner": "1.1.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tw-animate-css": "1.4.0"
  }
}
