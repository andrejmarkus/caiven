# Pinned versions for the Miyoo Mini (Plus) cross-build.
#
# Bumping either of these means re-verifying the whole chain by hand: the
# toolchain tarball has no changelog, and the SDL2 fork carries device-specific
# patches on top of upstream SDL2 with no tagged releases. Confirm a fresh
# `build-sdl2.sh` + `build-machine.sh` run still succeeds before bumping.

# https://github.com/steward-fu/website/releases — the toolchain steward-fu's
# sdl2 fork itself is built and tested against (glibc, arm-buildroot-linux-gnueabihf).
MIYOO_TOOLCHAIN_URL="https://github.com/steward-fu/website/releases/download/miyoo-mini/mini_toolchain-v1.0.tar.gz"

# https://github.com/steward-fu/sdl2 — SDL2 patched for the Miyoo Mini's
# SigmaStar 2D blitter (MI_GFX) and audio (MI_AO). Pinned by commit since the
# repo has no tags; re-pin deliberately, not as a drive-by bump.
MIYOO_SDL2_REPO="https://github.com/steward-fu/sdl2.git"
MIYOO_SDL2_COMMIT="0631abc8e8916db6f9bc7e2afd0c22913d092a29"
